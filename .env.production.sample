NODE_ENV=production
PORT=3001
# Supply actual deployment values; this template is intentionally not runnable.
MONGO_URI=
MONGO_DB_NAME=
CHAT_LINK_DOMAIN=
K3NCRYPT_ALLOWED_ORIGINS=
K3NCRYPT_TRUST_PROXY=true
K3NCRYPT_INSTANCE_COUNT=1
K3NCRYPT_DEVICE_TRUST_PROOF_SECRET=
CHATE2EE_API_URL=
CHATE2EE_ICE_SERVERS=[]
CHATE2EE_ICE_TRANSPORT_POLICY=all
CHATE2EE_ENABLE_DEBUG_LOGS=false
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Required in production. 'true' in normal operation; 'false' only during the documented cutover bridge.
K3NCRYPT_DURABLE_ROUTING=true
# Optional push wake-ups (content-free). Leave unset to keep push off; the relay then behaves exactly as before.
# K3NCRYPT_FCM_ENABLED=true
# K3NCRYPT_FCM_PROJECT_ID=<your Firebase project id>
# Path of the service-account JSON, uploaded as a Render Secret File (never committed): /etc/secrets/<file name>
# K3NCRYPT_FCM_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
