{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        "jsx": "react-jsx",
        /* Bundler mode */
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@k3ncrypt-vodozemac": ["../crypto-wasm/pkg/k3ncrypt_vodozemac.d.ts"]
        },
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}
